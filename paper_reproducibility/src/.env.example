# Application (safe defaults)
APP_HOST=0.0.0.0
APP_PORT=8100
APP_RELOAD=false
LOG_LEVEL=INFO
INITIALIZE_PROMPTS_ON_STARTUP=true

# Database (required; Compose overrides MONGO_URI with mongodb://mongo:27017)
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=stlc_database

# Authentication (enable for every server deployment; key is required when enabled)
API_AUTH_ENABLED=false
APP_API_KEY=

# CORS (comma-separated browser origins; never use * with authentication)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5175

# Model provider (required for generation)
# Compose/Desktop: host.docker.internal reaches LM Studio on the host.
# Direct host execution may instead use http://localhost:1234.
MODEL_API_BASE_URL=http://host.docker.internal:1234
MODEL_IDENTIFIER=llama-3.2-3b-instruct
# Optional for providers that require authentication.
MODEL_API_KEY=

# Existing MCP execution integration (optional; use localhost for direct host runs)
MCP_SERVER_URL=http://host.docker.internal:8001

# Execution adapter: "http" (independent executor) or "ssh_docker" (the
# verified ASRLAB -> IFARLAB SCP/SSH ROS 2 harness).
EXECUTION_ADAPTER=http

# Optional external HTTP test execution service.
EXECUTION_SERVICE_URL=
EXECUTION_SERVICE_TOKEN=
# Maximum duration for an HTTP or SSH/Docker execution request.
EXECUTION_TIMEOUT_SECONDS=1900

# ssh_docker adapter. SSH config aliases are supported (for example: ifarlab).
# The target must already contain the directory and ros2-exec-harness image.
SSH_EXECUTION_HOST=
SSH_EXECUTION_REMOTE_DIR=~/stlc_runs
SSH_EXECUTION_IMAGE=ros2-exec-harness:0.3.2
SSH_EXECUTION_IDENTITY_FILE=
# Optional fallback for unattended SSH when the private key cannot be unlocked.
# Keep this value only in the untracked .env file; never commit a real password.
SSH_EXECUTION_PASSWORD=
SSH_EXECUTION_CONNECT_TIMEOUT_SECONDS=10

# Generic monitoring history and SSE (MongoDB-backed, executor-independent)
MONITORING_ENABLED=true
MONITORING_EVENT_RETENTION_DAYS=30

# Deprecated optional local ROS 2 execution routes. These are unrelated to the
# external execution API and are not needed for normal startup or generation.
LEGACY_ROS2_IMAGE=stlc-robot-ros2:latest
LEGACY_ROS2_SETUP_SCRIPT=/opt/stlc_ros/install/setup.bash

# Storage (Compose overrides these with writable named-volume paths)
ARTIFACT_DIR=artifacts
UPLOAD_DIR=uploads
